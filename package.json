{
  "name": "mcpc-desktop-compiler",
  "version": "1.0.0",
  "description": "Desktop Application and Web Interface for MCPC MiniCPP Compiler",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "npx -y electron@latest .",
    "desktop": "npx -y electron@latest .",
    "dist": "npx -y electron-builder@latest --win nsis",
    "build:exe": "npx -y electron-builder@latest --win nsis"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mcpc.compiler",
    "productName": "CodeForge Desktop Compiler",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "package.json",
      "public/**/*",
      "codeforge/frontend/src/**/*",
      "codeforge/backend/src/**/*",
      "codeforge/backend/package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    }
  }
}
